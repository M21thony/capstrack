// CapsTrack ERD - the 30 tables the system uses for its main functions.
// Paste into https://dbdiagram.io (Import > DBML, or replace the editor text).
// Columns are the keys plus the ones that define each table; types are MySQL's.

// ── Users and roles ──────────────────────────────────────────────

Table students {
  student_id int [pk]
  student_number varchar(20)
  f_name varchar(50)
  l_name varchar(50)
  email varchar(100) [not null]
  course varchar(100)
}

Table student_s_y {
  s_y_id int [pk]
  student_id int [not null]
  team_id int
  school_year varchar(20)
  program "enum('BSIT','BSCS','BLIS','BSIS')"
  student_status "enum('Failed','Passed','Active')" [not null]
}

Table capstone_experts {
  expert_id int [pk]
  email varchar(250) [not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  program varchar(100)
  is_admin tinyint(1) [not null]
  approved_status tinyint(1) [not null]
  max_teams smallint
}

Table roles {
  role_id int [pk]
  role_name varchar(100) [not null]
}

Table expert_roles {
  expert_role_id int [pk]
  expert_id int [not null]
  role_id int [not null]
}

Table expert_expertise {
  expertise_id int [pk]
  expert_id int [not null]
  expertise_field varchar(100) [not null]
}

// ── Teams, expert applications, titles ───────────────────────────

Table team {
  team_id int [pk]
  leader_id int
  selected_pre_proposal_id int
  team_name varchar(100) [not null]
  project_title varchar(255)
  team_status "enum('Active','Full')" [not null]
}

Table capstone_expert_application {
  assignment_id int [pk]
  team_id int [not null]
  expert_id int [not null]
  expert_role_id int
  pre_proposal_id int
  status varchar(191) [not null]
}

Table capstone_pre_proposals {
  id int [pk]
  team_id int [not null]
  duplication_check_id int [not null]
  title varchar(255) [not null]
  adviser_status varchar(20)
  approved_status tinyint(1) [not null]
}

Table duplication_checks {
  id int [pk]
  student_s_y_id int [not null]
  top_score tinyint [not null]
  verdict varchar(191) [not null]
}

// ── Documents and reviews ────────────────────────────────────────

Table capstone_documents {
  file_id int [pk]
  team_id int
  student_id int [not null]
  deliverable_id int
  file_name varchar(191) [not null]
  file_version int [not null]
  document_status varchar(191) [not null]
}

Table capstone_document_review {
  review_id int [pk]
  file_id int [not null]
  expert_id int [not null]
  review_status "enum('To Review','Reviewing','Reviewed')" [not null]
  verdict varchar(32)
  reviewed_at timestamp
}

Table pdf_remarks {
  id int [pk]
  review_id int [not null]
  page_number int [not null]
  comment text
}

// ── Consultations ────────────────────────────────────────────────

Table consultation_schedule {
  schedule_id int [pk]
  expert_id int [not null]
  specific_date date
  start_time time
  end_time time
  consultation_limit int
}

Table consultation_booking {
  booking_id int [pk]
  student_id int [not null]
  schedule_id int [not null]
  session_date date
  booking_status "enum('scheduled','done','rescheduled','cancelled')" [not null]
}

// ── Defenses and grading ─────────────────────────────────────────

Table defense_schedule {
  defense_id int [pk]
  team_id int [not null]
  defense_type "enum('Pre-proposal Defense','Title Defense','Pre Oral Defense','Final Oral Defense')"
  schedule_date datetime
  venue varchar(40)
  outcome varchar(40)
}

Table defense_panels {
  defense_panel_id int [pk]
  defense_id int [not null]
  expert_id int [not null]
  panel_role "enum('Panel Chair','Panel Member 1','Panel Member 2')"
}

Table panel_grades {
  grade_id int [pk]
  defense_id int [not null]
  expert_id int [not null]
  rubric_id int [not null]
  total_score decimal(6,2)
  verdict varchar(191)
}

Table grading_rubrics {
  rubric_id int [pk]
  rubric_name varchar(191) [not null]
  rubric_type varchar(191) [not null]
  total_points decimal(6,2) [not null]
}

Table rubric_criteria {
  criterion_id int [pk]
  rubric_id int [not null]
  criterion_name varchar(191) [not null]
  max_points decimal(6,2) [not null]
}

// ── Requirements and progress ────────────────────────────────────

Table checklists {
  id int [pk]
  capsa_id int [not null]
  program varchar(8) [not null]
  title varchar(191) [not null]
}

Table checklist_milestones {
  id int [pk]
  checklist_id int [not null]
  name varchar(191) [not null]
  position int [not null]
}

Table deliverables {
  id int [pk]
  checklist_milestone_id int [not null]
  title varchar(191) [not null]
  due_date date
}

Table deliverable_checks {
  id int [pk]
  deliverable_id int [not null]
  team_id int [not null]
  file_id int
  status varchar(16) [not null]
}

// ── Fees and receipts ────────────────────────────────────────────

Table expense_posts {
  id int [pk]
  admin_id int
  title varchar(191) [not null]
  defense_type varchar(191)
  amount decimal(10,2) [not null]
}

Table financial_records {
  id int [pk]
  student_id int [not null]
  expense_post_id int
  amount decimal(10,2)
  f_record_status "enum('verified','pending','rejected')"
  verified_at timestamp
}

// ── Archive, resources, notifications ────────────────────────────

Table archived_documents {
  archived_id int [pk]
  team_id int
  title varchar(255) [not null]
  abstract text
  academic_year year [not null]
  program varchar(50) [not null]
}

Table resources {
  resource_id int [pk]
  uploaded_by int [not null]
  resource_type "enum('template','form','lesson')" [not null]
  title varchar(191) [not null]
  file_path varchar(500)
}

Table notifications {
  id int [pk]
  student_id int
  expert_id int
  type varchar(50) [not null]
  title varchar(255) [not null]
  is_read tinyint(1) [not null]
}

Table announcements {
  id int [pk]
  admin_id int [not null]
  team_id int
  title varchar(191) [not null]
  priority "enum('normal','important','urgent')" [not null]
}

// ── Relationships (many > one) ───────────────────────────────────

Ref: student_s_y.student_id > students.student_id
Ref: student_s_y.team_id > team.team_id
Ref: team.leader_id > students.student_id
Ref: team.selected_pre_proposal_id > capstone_pre_proposals.id

Ref: expert_roles.expert_id > capstone_experts.expert_id
Ref: expert_roles.role_id > roles.role_id
Ref: expert_expertise.expert_id > capstone_experts.expert_id

Ref: capstone_expert_application.team_id > team.team_id
Ref: capstone_expert_application.expert_id > capstone_experts.expert_id
Ref: capstone_expert_application.expert_role_id > expert_roles.expert_role_id
Ref: capstone_expert_application.pre_proposal_id > capstone_pre_proposals.id

Ref: capstone_pre_proposals.team_id > team.team_id
Ref: capstone_pre_proposals.duplication_check_id > duplication_checks.id
Ref: duplication_checks.student_s_y_id > student_s_y.s_y_id

Ref: capstone_documents.team_id > team.team_id
Ref: capstone_documents.student_id > students.student_id
Ref: capstone_documents.deliverable_id > deliverables.id
Ref: capstone_document_review.file_id > capstone_documents.file_id
Ref: capstone_document_review.expert_id > capstone_experts.expert_id
Ref: pdf_remarks.review_id > capstone_document_review.review_id

Ref: consultation_schedule.expert_id > capstone_experts.expert_id
Ref: consultation_booking.student_id > students.student_id
Ref: consultation_booking.schedule_id > consultation_schedule.schedule_id

Ref: defense_schedule.team_id > team.team_id
Ref: defense_panels.defense_id > defense_schedule.defense_id
Ref: defense_panels.expert_id > capstone_experts.expert_id
Ref: panel_grades.defense_id > defense_schedule.defense_id
Ref: panel_grades.expert_id > capstone_experts.expert_id
Ref: panel_grades.rubric_id > grading_rubrics.rubric_id
Ref: rubric_criteria.rubric_id > grading_rubrics.rubric_id

Ref: checklists.capsa_id > capstone_experts.expert_id
Ref: checklist_milestones.checklist_id > checklists.id
Ref: deliverables.checklist_milestone_id > checklist_milestones.id
Ref: deliverable_checks.deliverable_id > deliverables.id
Ref: deliverable_checks.team_id > team.team_id
Ref: deliverable_checks.file_id > capstone_documents.file_id

Ref: expense_posts.admin_id > capstone_experts.expert_id
Ref: financial_records.student_id > students.student_id
Ref: financial_records.expense_post_id > expense_posts.id

Ref: archived_documents.team_id > team.team_id
Ref: resources.uploaded_by > capstone_experts.expert_id
Ref: notifications.student_id > students.student_id
Ref: notifications.expert_id > capstone_experts.expert_id
Ref: announcements.admin_id > capstone_experts.expert_id
Ref: announcements.team_id > team.team_id
