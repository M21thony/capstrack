    "# 11. Merge the adapter, convert to GGUF, quantize to Q4_K_M.\n",
    "import os\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "MERGED_DIR = OUTPUT_NAME + \"-merged\"\n",
    "F16_GGUF = OUTPUT_NAME + \"-f16.gguf\"\n",
    "OUT_DIR = OUTPUT_NAME + \"-gguf\"\n",
    "Q4_GGUF = OUT_DIR + \"/\" + OUTPUT_NAME + \"-Q4_K_M.gguf\"\n",
    "\n",
    "if os.path.exists(MERGED_DIR) and os.listdir(MERGED_DIR):\n",
    "    print(\"merge already done - skipping\")\n",
    "else:\n",
    "    model.save_pretrained_merged(MERGED_DIR, tokenizer, save_method=\"merged_16bit\")\n",
    "    print(\"merged 16-bit model saved\")\n",
    "\n",
    "# Run the converter as a real subprocess. Unsloth imports it dynamically,\n",
    "# which does not put its own directory on sys.path, so the sibling\n",
    "# `conversion` package it depends on fails to import.\n",
    "c = subprocess.run([sys.executable, \"llama.cpp/convert_hf_to_gguf.py\", MERGED_DIR,\n",
    "                    \"--outfile\", F16_GGUF, \"--outtype\", \"f16\"],\n",
    "                   capture_output=True, text=True)\n",
    "print(\"convert exit:\", c.returncode)\n",
    "if c.returncode != 0 or not os.path.exists(F16_GGUF):\n",
    "    print(c.stdout[-2000:])\n",
    "    print(c.stderr[-2000:])\n",
    "    raise SystemExit(\"conversion failed - see above\")\n",
    "\n",
    "os.makedirs(OUT_DIR, exist_ok=True)\n",
    "q = subprocess.run([\"llama.cpp/llama-quantize\", F16_GGUF, Q4_GGUF, \"Q4_K_M\"],\n",
    "                   capture_output=True, text=True)\n",
    "print(\"quantize exit:\", q.returncode)\n",
    "if not os.path.exists(Q4_GGUF):\n",
    "    print(q.stdout[-2000:])\n",
    "    print(q.stderr[-2000:])\n",
    "    raise SystemExit(\"quantize failed - see above\")\n",
    "\n",
    "print(\"\\ndone: %s  (%.2f GB)\" % (Q4_GGUF, os.path.getsize(Q4_GGUF) / 1e9))"
