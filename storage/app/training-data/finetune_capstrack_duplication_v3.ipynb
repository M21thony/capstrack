   "source": [
    "# 3. Check the dataset BEFORE training.\n",
    "#\n",
    "# A malformed row does not fail loudly during training - it trains happily on\n",
    "# nonsense and the fault only shows an hour later, in the model. Everything\n",
    "# that can be checked cheaply is checked here.\n",
    "import collections\n",
    "import json\n",
    "\n",
    "REQUIRED = [\"matches\", \"score\", \"reason\", \"similarities\", \"differences\", \"suggestion\"]\n",
    "\n",
    "rows, problems = [], []\n",
    "with open(DATASET_PATH, encoding=\"utf-8\") as f:\n",
    "    for n, line in enumerate(f, 1):\n",
    "        line = line.strip()\n",
    "        if not line:\n",
    "            continue\n",
    "        try:\n",
    "            obj = json.loads(line)\n",
    "        except json.JSONDecodeError as e:\n",
    "            problems.append(\"line %d: not valid JSON - %s\" % (n, e))\n",
    "            continue\n",
    "        if not all(k in obj for k in (\"task\", \"prompt\", \"response\")):\n",
    "            problems.append(\"line %d: missing task/prompt/response\" % n)\n",
    "            continue\n",
    "        rows.append(obj)\n",
    "\n",
    "print(\"%d examples: %s\" % (len(rows), dict(collections.Counter(r[\"task\"] for r in rows))))\n",
    "\n",
    "# Every similarity answer must carry all six fields the app asks for. That is\n",
    "# the whole point of this retrain, so it is an error and not a warning.\n",
    "bands = collections.Counter()\n",
    "for r in rows:\n",
    "    if r[\"task\"] != \"similarity\":\n",
    "        continue\n",
    "    try:\n",
    "        v = json.loads(r[\"response\"])\n",
    "    except json.JSONDecodeError:\n",
    "        problems.append(\"similarity response is not JSON: %s\" % r[\"response\"][:70])\n",
    "        continue\n",
    "    if isinstance(v, list):\n",
    "        problems.append(\"similarity response is an ARRAY - that is the OLD batch shape, \"\n",
    "                        \"which is exactly what this retrain replaces\")\n",
    "        continue\n",
    "    missing = [k for k in REQUIRED if k not in v]\n",
    "    if missing:\n",
    "        problems.append(\"similarity response missing %s\" % missing)\n",
    "        continue\n",
    "    s = int(v[\"score\"])\n",
    "    bands[\"%d-%d\" % (s // 10 * 10, s // 10 * 10 + 9)] += 1\n",
    "\n",
    "print(\"\\nscore coverage:\")\n",
    "for lo in range(0, 100, 10):\n",
    "    key = \"%d-%d\" % (lo, lo + 9)\n",
    "    n = bands.get(key, 0)\n",
    "    print(\"  %-7s %3d  %s\" % (key, n, \"#\" * n))\n",
    "\n",
    "middle = sum(n for k, n in bands.items() if 30 <= int(k.split(\"-\")[0]) <= 60)\n",
    "if middle == 0:\n",
    "    problems.append(\"NO examples scoring 30-69. That gap is the reason for this retrain - \"\n",
    "                    \"training on this dataset would reproduce the current behaviour.\")\n",
    "\n",
    "if problems:\n",
    "    print(\"\\n=== PROBLEMS ===\")\n",
    "    for p in problems[:20]:\n",
    "        print(\" -\", p)\n",
    "    raise SystemExit(\"Fix the dataset before training. Nothing below will help.\")\n",
    "\n",
    "print(\"\\nOK - %d examples in the 30-69 band that used to be empty.\" % middle)"
   ]
  },
