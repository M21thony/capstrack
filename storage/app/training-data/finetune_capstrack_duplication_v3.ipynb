    "# 9. The test that decides whether this retrain is worth installing.\n",
    "#\n",
    "# This cell used to score ONE pair: CapsTrack against \"Capstone Project and\n",
    "# Thesis Class Information Management System\". That pair is written into the\n",
    "# judge prompt as a worked example, with the expected answer stated in the\n",
    "# prompt itself - so scoring it right proves the model can read its own\n",
    "# instructions, not that it learned anything. The previous retrain scored 75\n",
    "# on it and got WORSE on every uncontaminated case.\n",
    "#\n",
    "# heldout-v3.json is 15 pairs drawn from three topic families that appear\n",
    "# nowhere in the training data, scored by hand. A model that memorised has\n",
    "# nothing to copy for a family it never saw.\n",
    "#\n",
    "# The numbers to beat, measured on this same file, before this training run:\n",
    "#\n",
    "#     capstrack-duplication       average error  26.1\n",
    "#     capstrack-duplication-v3    average error  22.5   <- what is installed now\n",
    "#\n",
    "import json\n",
    "import re\n",
    "\n",
    "FastLanguageModel.for_inference(model)\n",
    "\n",
    "REQUIRED = [\"matches\", \"score\", \"reason\", \"similarities\", \"differences\", \"suggestion\"]\n",
    "\n",
    "\n",
    "def read_verdict(raw):\n",
    "    \"\"\"Read the first complete JSON object, exactly as the app does.\n",
    "\n",
    "    Not a greedy match to the last brace: the model sometimes closes its\n",
    "    object early and keeps writing, and a greedy match swallows the wreckage\n",
    "    and throws away a verdict that was perfectly usable up to that point. In\n",
    "    the app that reached students as \"Not assessed\".\n",
    "    \"\"\"\n",
    "    text = re.sub(r\"```json|```\", \"\", raw)\n",
    "    start = text.find(\"{\")\n",
    "    if start < 0:\n",
    "        return None\n",
    "    depth, in_string, escaped = 0, False, False\n",
    "    for i in range(start, len(text)):\n",
    "        ch = text[i]\n",
    "        if escaped:\n",
    "            escaped = False\n",
    "            continue\n",
    "        if ch == \"\\\\\":\n",
    "            escaped = True\n",
    "            continue\n",
    "        if ch == '\"':\n",
    "            in_string = not in_string\n",
    "            continue\n",
    "        if in_string:\n",
    "            continue\n",
    "        if ch == \"{\":\n",
    "            depth += 1\n",
    "        elif ch == \"}\":\n",
    "            depth -= 1\n",
    "            if depth == 0:\n",
    "                try:\n",
    "                    return json.loads(text[start:i + 1])\n",
    "                except json.JSONDecodeError:\n",
    "                    return None\n",
    "    return None\n",
    "\n",
    "\n",
    "def judge(prompt):\n",
    "    inputs = tokenizer.apply_chat_template(\n",
    "        [{\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "         {\"role\": \"user\", \"content\": prompt}],\n",
    "        tokenize=True, add_generation_prompt=True, return_tensors=\"pt\").to(\"cuda\")\n",
    "    out = model.generate(input_ids=inputs, max_new_tokens=400, use_cache=True, do_sample=False)\n",
    "    return tokenizer.decode(out[0][inputs.shape[1]:], skip_special_tokens=True)\n",
    "\n",
    "\n",
    "held = json.load(open(HELDOUT_PATH, encoding=\"utf-8\"))\n",
    "print(\"scoring %d held-out pairs - none of these topics are in the training data\" % len(held))\n",
    "print()\n",
    "\n",
