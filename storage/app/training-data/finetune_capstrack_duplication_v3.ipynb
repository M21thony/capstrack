    "# 4. Base model and context window.\n",
    "#\n",
    "# 3B matches what runs locally and fits a free T4. The longest example is\n",
    "# around 2,200 tokens, so 4096 leaves real headroom - raising it costs VRAM\n",
    "# for nothing.\n",
    "MODEL_SIZE = \"3B\"\n",
    "\n",
    "BASE_MODEL = {\n",
    "    \"3B\": \"unsloth/Qwen2.5-3B-Instruct\",\n",
    "    \"7B\": \"unsloth/Qwen2.5-7B-Instruct\",\n",
    "}[MODEL_SIZE]\n",
    "\n",
    "MAX_SEQ_LENGTH = 4096\n",
    "OUTPUT_NAME = \"capstrack-duplication-v3\"\n",
    "\n",
    "print(\"Base model:\", BASE_MODEL)\n",
    "print(\"Output    :\", OUTPUT_NAME)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. Confirm the whole dataset fits the context window.\n",
    "#\n",
    "# Anything longer is silently truncated by the trainer, and a similarity\n",
    "# example cut mid-prompt teaches the model to answer without having read the\n",
    "# archived document.\n",
    "from transformers import AutoTokenizer\n",
    "\n",
    "_tok = AutoTokenizer.from_pretrained(BASE_MODEL)\n",
    "lengths = sorted(len(_tok(r[\"prompt\"] + r[\"response\"]).input_ids) for r in rows)\n",
    "\n",
    "# Never start a continuation line with %: Jupyter reads a leading % as a\n",
    "# magic, so the modulo lands where a cell magic is expected.\n",
    "print(\"tokens per example: median {}, p95 {}, max {}\".format(\n",
    "    lengths[len(lengths) // 2], lengths[int(len(lengths) * 0.95)], lengths[-1]))\n",
    "print(\"MAX_SEQ_LENGTH   :\", MAX_SEQ_LENGTH)\n",
    "\n",
    "over = sum(1 for n in lengths if n > MAX_SEQ_LENGTH)\n",
    "if over:\n",
    "    raise SystemExit(\"%d examples exceed the window and would be truncated. \"\n",
    "                     \"Raise MAX_SEQ_LENGTH to at least %d.\" % (over, lengths[-1] + 64))\n",
    "print(\"OK - nothing is truncated.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. Load the base model in 4-bit (QLoRA).\n",
    "from unsloth import FastLanguageModel\n",
    "import torch\n",
    "\n",
    "model, tokenizer = FastLanguageModel.from_pretrained(\n",
    "    model_name=BASE_MODEL,\n",
    "    max_seq_length=MAX_SEQ_LENGTH,\n",
    "    dtype=None,\n",
    "    load_in_4bit=True,\n",
    ")\n",
    "\n",
    "model = FastLanguageModel.get_peft_model(\n",
    "    model,\n",
    "    r=16,\n",
    "    target_modules=[\"q_proj\", \"k_proj\", \"v_proj\", \"o_proj\",\n",
    "                    \"gate_proj\", \"up_proj\", \"down_proj\"],\n",
    "    lora_alpha=16,\n",
    "    lora_dropout=0,\n",
    "    bias=\"none\",\n",
    "    use_gradient_checkpointing=\"unsloth\",\n",
    "    random_state=3407,\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7. Format into Qwen's chat template.\n",
    "#\n",
    "# SYSTEM_PROMPT must match the Modelfile the local Ollama model is created\n",
    "# with, or the model meets a different preamble in production than in\n",
    "# training.\n",
    "from datasets import Dataset\n",
    "\n",
    "SYSTEM_PROMPT = \"You are Qwen, created by Alibaba Cloud. You are a helpful assistant.\"\n",
    "\n",
    "messages = [{\n",
    "    \"messages\": [\n",
    "        {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n",
    "        {\"role\": \"user\", \"content\": r[\"prompt\"]},\n",
    "        {\"role\": \"assistant\", \"content\": r[\"response\"]},\n",
    "    ]\n",
    "} for r in rows]\n",
    "\n",
    "dataset = Dataset.from_list(messages).map(\n",
    "    lambda e: {\"text\": tokenizer.apply_chat_template(\n",
    "        e[\"messages\"], tokenize=False, add_generation_prompt=False)}\n",
    ")\n",
    "print(\"%d examples ready\" % len(dataset))\n",
    "print(dataset[0][\"text\"][:400])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8. Train. Roughly 15-25 minutes on a free T4.\n",
    "#\n",
    "# WHY train_on_responses_only IS HERE\n",
    "#\n",
    "# Without it the loss is computed over the WHOLE sequence. A similarity\n",
    "# example is a judge prompt of about 2,500 tokens followed by an answer of\n",
    "# about 120, and that prompt is near-identical across all 167 of them - so\n",
    "# roughly 95% of the training signal is \"reproduce a prompt you have already\n",
    "# seen 167 times\", and the answer barely registers.\n",
    "#\n",
    "# A model trained that way learns the prompt and gives up on the answer. The\n",
    "# previous run did exactly that: it replied 25 to fourteen of the fifteen\n",
    "# held-out pairs, ignoring the input entirely. Masking the prompt puts the\n",
    "# loss where the learning has to happen.\n",
    "from trl import SFTConfig, SFTTrainer\n",
    "from unsloth.chat_templates import train_on_responses_only\n",
    "\n",
    "trainer = SFTTrainer(\n",
    "    model=model,\n",
    "    tokenizer=tokenizer,\n",
    "    train_dataset=dataset,\n",
    "    dataset_text_field=\"text\",\n",
    "    max_seq_length=MAX_SEQ_LENGTH,\n",
    "    packing=False,\n",
    "    args=SFTConfig(\n",
    "        per_device_train_batch_size=2,\n",
    "        gradient_accumulation_steps=4,\n",
    "        warmup_steps=10,\n",
    "        num_train_epochs=3,\n",
    "        learning_rate=2e-4,\n",
    "        logging_steps=10,\n",
    "        optim=\"adamw_8bit\",\n",
    "        weight_decay=0.01,\n",
    "        lr_scheduler_type=\"linear\",\n",
    "        seed=3407,\n",
    "        output_dir=\"outputs\",\n",
    "        report_to=\"none\",\n",
    "    ),\n",
    ")\n",
    "\n",
    "# Qwen uses the ChatML markers below. If these strings are wrong the call\n",
    "# silently masks nothing, so the count printed next is the proof.\n",
    "trainer = train_on_responses_only(\n",
    "    trainer,\n",
    "    instruction_part=\"<|im_start|>user\\n\",\n",
    "    response_part=\"<|im_start|>assistant\\n\",\n",
    ")\n",
    "\n",
    "# Proof that the masking took. Labels of -100 are ignored by the loss; what is\n",
    "# left should be the answer alone, and it should be a small slice of the whole.\n",
    "_ex = trainer.train_dataset[0]\n",
    "_kept = [t for t in _ex[\"labels\"] if t != -100]\n",
    "print(\"tokens in example 0 : %d\" % len(_ex[\"labels\"]))\n",
    "print(\"tokens trained on   : %d  (%.0f%%)\" % (len(_kept), 100 * len(_kept) / len(_ex[\"labels\"])))\n",
    "print(\"what is trained on  :\", tokenizer.decode(_kept)[:160].replace(\"\\n\", \" \"))\n",
    "\n",
    "if len(_kept) == len(_ex[\"labels\"]):\n",
    "    raise SystemExit(\"Masking did not take - the loss still covers the prompt. \"\n",
    "                     \"The instruction_part/response_part markers are wrong for this \"\n",
    "                     \"template; check tokenizer.chat_template before training.\")\n",
    "if len(_kept) > len(_ex[\"labels\"]) * 0.5:\n",
    "    raise SystemExit(\"More than half the sequence is still being trained on. That \"\n",
    "                     \"is not an answer, it is an answer plus prompt.\")\n",
    "\n",
    "trainer_stats = trainer.train()\n",
    "print(\"\\nThe loss should fall and then flatten. If it never falls, the data or \"\n",
    "      \"the chat template is wrong - do not export.\")\n"
   ]
  },
