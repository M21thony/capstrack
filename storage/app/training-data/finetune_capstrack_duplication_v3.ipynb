    "# 2. Upload BOTH files from storage/app/training-data/ in the repo:\n",
    "#      dataset-v3.jsonl   - what this trains on\n",
    "#      heldout-v3.json    - what cell 9 judges the result with\n",
    "#\n",
    "# Picked by name, not by upload order, so the order you choose them in the\n",
    "# file dialog does not matter.\n",
    "from google.colab import files\n",
    "\n",
    "uploaded = files.upload()\n",
    "\n",
    "DATASET_PATH = next((n for n in uploaded if n.endswith(\".jsonl\")), None)\n",
    "HELDOUT_PATH = next((n for n in uploaded if \"heldout\" in n.lower()), None)\n",
    "\n",
    "if DATASET_PATH is None:\n",
    "    raise SystemExit(\"No .jsonl uploaded - dataset-v3.jsonl is the one to pick.\")\n",
    "if HELDOUT_PATH is None:\n",
    "    print(\"WARNING: heldout-v3.json was not uploaded. Cell 9 cannot tell you \"\n",
    "          \"whether the retrain worked, and you would be exporting blind.\")\n",
    "\n",
    "print(\"training on :\", DATASET_PATH)\n",
    "print(\"judged with :\", HELDOUT_PATH)\n"
   ]
