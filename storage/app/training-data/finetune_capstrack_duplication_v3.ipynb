    "# 1. Dependencies.\n",
    "#\n",
    "# --no-deps is what keeps pip from dragging in a torch that Colab's GPU\n",
    "# driver will not run. The cost is that unsloth's own requirements are\n",
    "# skipped, so any it grows have to be named here by hand - structlog, tyro\n",
    "# and msgspec are exactly that, added after unsloth 2026.9.2.\n",
    "#\n",
    "# cut_cross_entropy is not on PyPI. It comes from Apple's repository, which\n",
    "# is why \"pip install cut_cross_entropy\" quietly does nothing.\n",
    "#\n",
    "# trl is pinned LAST because something in the lines above pulls trl 1.12,\n",
    "# which is far outside the <=0.24 that unsloth accepts.\n",
    "!pip install -q sentencepiece protobuf \"datasets==4.3.0\" \"huggingface_hub>=0.34.0\" hf_transfer\n",
    "!pip install -q --no-deps unsloth_zoo bitsandbytes accelerate xformers peft trl triton unsloth\n",
    "!pip install -q --no-deps --upgrade \"torchao>=0.16.0\"\n",
    "!pip install -q structlog tyro msgspec\n",
    "!pip install -q --no-deps \"cut-cross-entropy[transformers] @ git+https://github.com/apple/ml-cross-entropy.git\"\n",
    "!pip install -q transformers==4.56.2\n",
    "!pip install -q --no-deps trl==0.22.2\n",
    "\n",
    "# pip prints dependency-conflict warnings above whatever happens. They do not\n",
    "# tell you whether this worked. This does.\n",
    "import importlib\n",
    "\n",
    "missing = [p for p in (\"structlog\", \"tyro\", \"msgspec\", \"cut_cross_entropy\")\n",
    "           if not importlib.util.find_spec(p)]\n",
    "\n",
    "import trl\n",
    "import transformers\n",
    "print(\"trl\", trl.__version__, \"(want 0.22.2)\")\n",
    "print(\"transformers\", transformers.__version__, \"(want 4.56.2)\")\n",
    "print(\"missing:\", missing or \"nothing\")\n",
    "\n",
    "from unsloth import FastLanguageModel\n",
    "print(\"\\nREADY - unsloth imported. Ignore any red text above; this line is the test.\")"
   ]
