    "# 10. Build llama.cpp for the GGUF export.\n",
    "#\n",
    "# Unsloth's save_pretrained_gguf() has hit two separate bugs against current\n",
    "# llama.cpp, so the three real steps are done directly. The quantizer is\n",
    "# copied to llama.cpp/ root because that is where unsloth_zoo looks for it.\n",
    "#\n",
    "# If the runtime disconnects, /content is wiped - re-run this whole cell.\n",
    "import os\n",
    "import shutil\n",
    "import subprocess\n",
    "\n",
    "if not os.path.exists(\"llama.cpp\"):\n",
    "    !git clone --depth 1 https://github.com/ggml-org/llama.cpp\n",
    "\n",
    "!rm -rf llama.cpp/build\n",
    "!cmake llama.cpp -B llama.cpp/build -DBUILD_SHARED_LIBS=OFF -DGGML_CUDA=OFF 2>&1 | tail -5\n",
    "!cmake --build llama.cpp/build --config Release -j$(nproc) --target llama-quantize llama-cli 2>&1 | tail -5\n",
    "\n",
    "for name in [\"llama-quantize\", \"llama-cli\"]:\n",
    "    src, dst = \"llama.cpp/build/bin/\" + name, \"llama.cpp/\" + name\n",
    "    if not os.path.exists(src):\n",
    "        raise SystemExit(\"build did not produce %s - scroll up for the real error\" % src)\n",
    "    shutil.copy(src, dst)\n",
    "    os.chmod(dst, 0o755)\n",
    "    print(\"copied\", dst)\n",
    "\n",
    "r = subprocess.run([\"llama.cpp/llama-quantize\", \"--help\"],\n",
    "                   capture_output=True, text=True, timeout=10)\n",
    "print(\"quantizer self-test:\",\n",
    "      \"ok\" if \"usage\" in (r.stdout + r.stderr).lower() else \"FAILED\")"
