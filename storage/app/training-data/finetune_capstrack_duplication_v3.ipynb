    "# Average error is not enough on its own. A model that answers the same\n",
    "# number to everything scores well here, because most of these pairs are\n",
    "# genuinely low - and that is exactly what the last two retrains produced.\n",
    "# The judge exists to FLAG duplicates, so it has to be able to reach a\n",
    "# flagging score at all, and it has to tell pairs apart.\n",
    "spread = len(set(scores))\n",
    "highest = max(scores) if scores else 0\n",
    "print(\"distinct scores : %d of %d answers\" % (spread, len(scores)))\n",
    "print(\"highest score   : %d   (a match is flagged at 55)\" % highest)\n",
    "\n",
    "print()\n",
    "if spread <= 3:\n",
    "    print(\"STOP. It gave %d distinct answers to %d different pairs - it is not\" % (spread, len(scores)))\n",
    "    print(\"reading the input, it is repeating a number. Do not export.\")\n",
