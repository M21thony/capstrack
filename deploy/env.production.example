# CapsTrack production settings. Copy to /var/www/capstrack/.env on the
# server and fill in every <...>. Never commit the filled-in copy.

APP_NAME=CapsTrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<your-domain-or-azure-address>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capstrack
DB_USERNAME=capstrack
DB_PASSWORD=<strong-password>

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Uploaded files on MinIO (S3-compatible). Leave false to keep them in storage/app.
FILES_ON_S3=false
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=capstrack-private
AWS_PUBLIC_BUCKET=capstrack-public
AWS_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<from-address>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google: add BOTH of these to the OAuth client's Authorized redirect URIs,
# and APP_URL to its Authorized JavaScript origins, or Drive connect fails
# without saying why:
#   https://<your-domain>/login/google/callback
#   https://<your-domain>/admin/gdrive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<your-domain-or-azure-address>/login/google/callback
GOOGLE_PICKER_API_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# The AI. Set OLLAMA_URL to reach Ollama directly (a RunPod pod's
# https://<pod-id>-11434.proxy.runpod.net). Leave it empty to go through the
# SSH_TUNNEL_* settings to a Windows machine instead.
OLLAMA_URL=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MODEL=capstrack-duplication
OLLAMA_JUDGE_MODEL=capstrack-duplication-v3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_JUDGE_LIMIT=10

SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=
SSH_TUNNEL_KEY_PATH=

# Keep the same pair as the laptop if students already subscribed there;
# a new pair silently unsubscribes every browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:capstrack@cspc.edu.ph
